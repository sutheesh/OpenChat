*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
*.spec

# Virtual environments
venv/
env/
ENV/
.venv/
.env/
finetune_env/
*_env/

